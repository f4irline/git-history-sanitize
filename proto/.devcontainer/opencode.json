{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "lsp",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
